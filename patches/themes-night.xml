<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VideoShrink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#10204F</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="ShapeAppearanceOverlay.VideoShrink.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>
